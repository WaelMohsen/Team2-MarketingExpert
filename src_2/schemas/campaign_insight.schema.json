{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignInsight",
  "type": "object",
  "required": [
    "campaign_id",
    "target_assessment",
    "supporting_evidence",
    "strategic_lesson",
    "evidence_status"
  ],
  "properties": {
    "campaign_id": {"type": "string"},
    "target_assessment": {"type": "string"},
    "supporting_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceReference"}
    },
    "performance_drivers": {"type": "array", "items": {"type": "string"}},
    "audience_findings": {"type": "array", "items": {"type": "string"}},
    "creative_findings": {"type": "array", "items": {"type": "string"}},
    "risks_and_confounders": {"type": "array", "items": {"type": "string"}},
    "strategic_lesson": {"type": "string"},
    "next_controlled_test": {"type": ["string", "null"]},
    "evidence_status": {
      "enum": ["ready", "limited_evidence", "insufficient_evidence", "data_not_ready"]
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "required": ["entity_level", "entity_id", "metric", "actual"],
      "properties": {
        "entity_level": {
          "enum": ["campaign", "adset", "ad", "creative", "audience"]
        },
        "entity_id": {"type": "string"},
        "metric": {"type": "string"},
        "actual": {"type": ["number", "null"]},
        "benchmark": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
