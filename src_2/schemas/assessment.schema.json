{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignAssessment",
  "type": "object",
  "required": [
    "cycle_id",
    "campaign_id",
    "campaign_name",
    "campaign_type",
    "target_status",
    "next_cycle_action",
    "evidence_status",
    "primary_results",
    "guardrail_results"
  ],
  "properties": {
    "cycle_id": {"type": "string"},
    "campaign_id": {"type": "string"},
    "campaign_name": {"type": "string"},
    "campaign_type": {"type": "string"},
    "target_status": {
      "enum": ["achieved", "achieved_with_concerns", "not_achieved", "insufficient_evidence", "data_not_ready"]
    },
    "next_cycle_action": {
      "enum": ["scale", "keep_as_test", "do_not_fund", "insufficient_evidence", "data_not_ready"]
    },
    "evidence_status": {
      "enum": ["ready", "limited_evidence", "insufficient_evidence", "data_not_ready"]
    },
    "primary_results": {"type": "array"},
    "guardrail_results": {"type": "array"},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
